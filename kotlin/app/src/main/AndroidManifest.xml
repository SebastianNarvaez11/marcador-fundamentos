<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso PELIGROSO desde la API 33: declararlo aqui no basta, ademas se pide
         en tiempo de ejecucion. Sin la linea, el dialogo nunca aparece y el
         sistema deniega siempre. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MarcadorApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Segunda pantalla. exported="true" porque tiene intent-filter y otras apps
             (el navegador, adb) deben poder lanzarla. Casa con marcador://partido/<n>:
             VIEW = «ver esto»; DEFAULT = imprescindible para los intents implicitos
             de startActivity; BROWSABLE = permite abrirla desde un enlace del navegador. -->
        <activity
            android:name=".DetalleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="marcador" android:host="partido" />
            </intent-filter>
        </activity>
    </application>

</manifest>
